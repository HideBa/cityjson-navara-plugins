{
  "name": "@cityjson/navara-cityjson",
  "version": "0.0.0",
  "description": "Navara plugin rendering static CityJSON / CityJSONSeq city models",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --dir tests"
  },
  "dependencies": {
    "@cityjson/navara-core": "file:../navara-core"
  },
  "peerDependencies": {
    "@navaramap/three": "0.0.5",
    "@navaramap/three-default-plugin": "0.0.5",
    "proj4": ">=2.20.0",
    "three": ">=0.183.0"
  },
  "devDependencies": {
    "@navaramap/three": "0.0.5",
    "@navaramap/three-default-plugin": "0.0.5",
    "@types/three": "0.183.1",
    "proj4": "2.20.8",
    "three": "0.183.2",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
